"""
DATA PROCESSING & KPI CALCULATION
Persistence · Adherence (PDC/MPR) · Compliance
"""
import pandas as pd
import numpy as np

df = pd.read_csv('/home/claude/med_pipeline/cleaned_data.csv', parse_dates=['prescription_date','discontinuation_date'])

# ═══════════════════════════════════════════════════════════════
# CORE METRIC CALCULATIONS
# ═══════════════════════════════════════════════════════════════

# ── 1. PDC (Proportion of Days Covered) ──────────────────────
#    PDC = days with medication / observation period
df['observation_days'] = 365
df['days_covered'] = df['pdc_raw'] * df['observation_days']
df['pdc'] = (df['days_covered'] / df['observation_days']).round(4)
df['adherent'] = (df['pdc'] >= 0.80).astype(int)      # ≥80% = adherent
df['partial_adherent'] = ((df['pdc'] >= 0.50) & (df['pdc'] < 0.80)).astype(int)
df['non_adherent'] = (df['pdc'] < 0.50).astype(int)

# ── 2. MPR (Medication Possession Ratio) ─────────────────────
#    MPR = total days supply dispensed / days in study period
df['mpr'] = (df['refill_count'] * df['days_supply'] / df['observation_days']).round(4).clip(0,1)

# ── 3. Persistence ───────────────────────────────────────────
df['persistence_flag'] = (df['discontinued'] == 0).astype(int)
# Persistence band
df['persistence_band'] = pd.cut(df['persistence_days'],
    bins=[0,90,180,270,365],
    labels=['0-90d','91-180d','181-270d','271-365d'])

# ── 4. Compliance Score ──────────────────────────────────────
#    Composite: correct dose + timing + no extras
df['compliance_score'] = (
    (df['doses_taken'] / df['doses_prescribed']).clip(0,1) * 0.50 +
    df['dose_timing_correct'].astype(float) * 0.35 +
    (~df['extra_dose_event']).astype(float) * 0.15
).round(4)
df['compliance_category'] = pd.cut(df['compliance_score'],
    bins=[0,0.50,0.75,1.01],
    labels=['Non-compliant','Partially compliant','Compliant'])

# ── 5. Risk Score ────────────────────────────────────────────
df['risk_score'] = (
    (1 - df['pdc']) * 40 +
    (1 - df['compliance_score']) * 30 +
    df['discontinued'] * 20 +
    df['side_effects_reported'].astype(int) * 10
).round(2)
df['risk_category'] = pd.cut(df['risk_score'],
    bins=[0,25,50,75,101],
    labels=['Low','Moderate','High','Critical'])

df.to_csv('/home/claude/med_pipeline/processed_data.csv', index=False)
